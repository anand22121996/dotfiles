### -------- Zinit install --------
if [[ ! -f ~/.local/share/zinit/zinit.git/zinit.zsh ]]; then
  echo "Zinit not found. Install it first."
  return
fi

source ~/.local/share/zinit/zinit.git/zinit.zsh

### -------- Theme: Powerlevel10k --------
zinit ice depth=1
zinit light romkatv/powerlevel10k

# Powerlevel10k instant prompt (recommended)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi


. "$HOME/.atuin/bin/env"

eval "$(atuin init zsh)"

### -------- Completion Setup --------
autoload -Uz compinit
compinit

# Optional: better completion menu
zstyle ':completion:*' menu no

# Color files/directories in the fzf-tab candidate list
# using LS_COLORS.
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Show completion descriptions/groups.
# IMPORTANT: don't put %F{} color escapes here;
# fzf-tab uses this format to detect groups.
zstyle ':completion:*:descriptions' format '[%d]'

# Include hidden files/directories
#setopt globdots

### -------- Plugins --------
zinit light Aloxaf/fzf-tab

# fzf-tab configuration
zstyle ':fzf-tab:*' fzf-command fzf
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' fzf-flags '--height=60%' '--layout=reverse' '--border'

# File/directory preview
zstyle ':fzf-tab:complete:*:*' fzf-preview '
    if [[ -d "$realpath" ]]; then
        eza --all --tree --level=2 --color=always --icons=always "$realpath" 2>/dev/null
    elif [[ -f "$realpath" ]]; then
        bat --color=always --style=numbers --line-range=:300 "$realpath" 2>/dev/null
   fi
'

# Fast Syntax Highlighting
zinit light zdharma-continuum/fast-syntax-highlighting

# Autosuggestions
zinit light zsh-users/zsh-autosuggestions

# Autocomplete (must load AFTER compinit stuff)
#zinit light marlonrichert/zsh-autocomplete

# Open buffer line in editor
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^x^e' edit-command-line

# do history expansion on space
bindkey " " magic-space 
bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line
bindkey "^[[3~" delete-char

#enable vi mode in zsh
bindkey -v

# Remove '/' from word characters so Alt+f stops at path slashes (.config/)
WORDCHARS=${WORDCHARS//[\/]}

# Bind Alt+f to forward-word for partial suggestion accept
#bindkey "^[[C" forward-word

# Disable Zsh internal history saving
unset HISTFILE
HISTSIZE=0
SAVEHIST=0

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

. "/home/anand/.deno/env"

eval "$(zoxide init zsh --cmd cd)"

# Load a few important annexes, without Turbo
# (this is currently required for annexes)
zinit light-mode for \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/zinit-annex-patch-dl \
    zdharma-continuum/zinit-annex-rust

### End of Zinit's installer chunk
### End of Zinit's installer chunk
stty -ixon
bindkey -r "^S"
