### -------- Zinit install --------
if [[ ! -f ~/.local/share/zinit/zinit.git/zinit.zsh ]]; then
  echo "Zinit not found. Install it first."
  return
fi

source ~/.local/share/zinit/zinit.git/zinit.zsh

### -------- Theme: Powerlevel10k --------
zinit ice depth=1
zinit light romkatv/powerlevel10k

# Powerlevel10k instant prompt (recommended)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

### -------- Completion Setup --------
autoload -Uz compinit
compinit

# Optional: better completion menu
zstyle ':completion:*' menu select

### -------- Plugins --------

# Fast Syntax Highlighting
zinit light zdharma-continuum/fast-syntax-highlighting

# Autosuggestions
zinit light zsh-users/zsh-autosuggestions

# Autocomplete (must load AFTER compinit stuff)
zinit light marlonrichert/zsh-autocomplete

# Custom Alias
alias sudo='sudo '
alias vim='nvim'
#alias ls='lsd'
alias ls='eza --icons --git --header --group-directories-first --color-scale --time-style=long-iso'
alias l='ls'
alias ll='ls -a'
alias lll='ls -la'

# Set Vim as the default editor for sudoedit and git
export EDITOR=nvim

# Disable Zsh internal history saving
unset HISTFILE
HISTSIZE=0
SAVEHIST=0

export IDEA="/home/anand/.local/share/JetBrains/idea-IU-253.30387.90" 
export PATH="$IDEA/bin:$PATH"

export DENO="/home/anand/.deno"
export PATH="$DENO/bin:$PATH"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
. "/home/anand/.deno/env"

. "$HOME/.atuin/bin/env"

eval "$(atuin init zsh)"
eval "$(zoxide init zsh)"

# Load a few important annexes, without Turbo
# (this is currently required for annexes)
zinit light-mode for \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/zinit-annex-patch-dl \
    zdharma-continuum/zinit-annex-rust

